---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	heroImage,
	day,
	routeStart,
	routeEnd,
	distanceKm,
	elevationM,
	photos = [],
} =
	Astro.props;

const route =
	routeStart || routeEnd
		? `${routeStart ?? ''}${routeStart && routeEnd ? ' → ' : ''}${routeEnd ?? ''}`
		: 'Route pending';
const pageTitle = title ?? `${day ? `Day ${day}` : 'Update'} · ${route}`;
const pageDescription = description ?? `Update from ${route}`;
const normalizedPhotos = photos.map((photo) =>
	typeof photo === 'string'
		? {
				src: photo,
				caption: 'View photo',
			}
		: {
				src: photo.src,
				caption: photo.caption ?? 'View photo',
			},
);
---

<html lang="en">
	<head>
		<BaseHead title={pageTitle} description={pageDescription} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.post-gallery {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
				gap: 0.75rem;
				margin-top: 1.5rem;
			}
			.gallery-photo {
				display: grid;
				grid-template-rows: 1fr auto;
				padding: 0;
				overflow: hidden;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 16px;
				background: white;
				color: inherit;
				font: inherit;
				text-align: left;
				cursor: pointer;
			}
			.gallery-photo figure {
				margin: 0;
			}
			.gallery-photo img {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				transition: transform 0.2s ease;
			}
			.gallery-photo figcaption {
				padding: 0.55rem 0.65rem;
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
				line-height: 1.3;
			}
			.gallery-photo:hover img {
				transform: scale(1.03);
			}
			.gallery-dialog {
				width: min(1100px, calc(100% - 1rem));
				max-height: calc(100vh - 1rem);
				padding: 0;
				border: 0;
				border-radius: 24px;
				background: rgb(var(--gray-dark));
				color: white;
				box-shadow: 0 24px 70px rgba(var(--black), 45%);
			}
			.gallery-dialog::backdrop {
				background: rgba(var(--black), 75%);
				backdrop-filter: blur(3px);
			}
			.gallery-inner {
				display: grid;
				grid-template-columns: auto minmax(0, 1fr) auto;
				align-items: center;
				gap: 0.75rem;
				padding: 1rem;
			}
			.gallery-image-wrap img {
				display: block;
				width: 100%;
				max-height: calc(100vh - 9rem);
				object-fit: contain;
				border-radius: 16px;
			}
			.gallery-caption {
				margin: 0.75rem 0 0;
				color: rgba(255, 255, 255, 0.82);
				text-align: center;
			}
			.gallery-close,
			.gallery-nav {
				border: 0;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.14);
				color: white;
				font: inherit;
				cursor: pointer;
			}
			.gallery-close {
				position: absolute;
				top: 0.75rem;
				right: 0.75rem;
				width: 2.4rem;
				height: 2.4rem;
			}
			.gallery-nav {
				width: 2.8rem;
				height: 2.8rem;
				font-size: 1.8rem;
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.details {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 0.75rem;
				margin: 1.5rem 0;
				text-align: left;
			}
			.detail {
				padding: 0.8rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				background: white;
			}
			.trip-label {
				display: block;
				color: rgb(var(--gray));
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.06em;
			}
			.detail strong {
				display: block;
				margin-top: 0.15rem;
				color: rgb(var(--black));
				font-size: 1rem;
			}
			.photo-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 1rem;
				margin-top: 2rem;
			}
			.photo-grid img {
				aspect-ratio: 4 / 3;
				object-fit: cover;
				width: 100%;
			}
			@media (max-width: 720px) {
				.details {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.post-gallery {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
				.gallery-inner {
					grid-template-columns: 1fr;
					padding: 0.75rem;
				}
				.gallery-nav {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
						</div>
						<h1>{pageTitle}</h1>
						{
							(day || routeStart || routeEnd || distanceKm || elevationM) && (
								<div class="details">
									{day && (
										<div class="detail">
											<span class="trip-label">Day</span>
											<strong>{day}</strong>
										</div>
									)}
									{(routeStart || routeEnd) && (
										<div class="detail">
											<span class="trip-label">Route</span>
											<strong>
												{routeStart}
												{routeStart && routeEnd ? ' → ' : ''}
												{routeEnd}
											</strong>
										</div>
									)}
									{distanceKm && (
										<div class="detail">
											<span class="trip-label">Distance</span>
											<strong>{distanceKm} km</strong>
										</div>
									)}
									{elevationM && (
										<div class="detail">
											<span class="trip-label">Elevation</span>
											<strong>{elevationM} m</strong>
										</div>
									)}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
					{
						normalizedPhotos.length > 0 && (
							<div class="post-gallery" aria-label="Ride photos">
								{normalizedPhotos.map((photo, photoIndex) => (
									<button class="gallery-photo" type="button" data-photo={photoIndex}>
										<figure>
											<img src={photo.src} alt={photo.caption ?? ''} loading="lazy" />
											<figcaption>{photo.caption}</figcaption>
										</figure>
									</button>
								))}
							</div>
						)
					}
				</div>
			</article>
		</main>
		<dialog class="gallery-dialog" id="gallery-dialog" aria-label="Photo gallery">
			<button class="gallery-close" type="button" data-gallery-close aria-label="Close gallery">×</button>
			<div class="gallery-inner">
				<button class="gallery-nav" type="button" data-gallery-prev aria-label="Previous photo">‹</button>
				<div class="gallery-image-wrap">
					<img data-gallery-image alt="" />
					<p class="gallery-caption" data-gallery-caption></p>
				</div>
				<button class="gallery-nav" type="button" data-gallery-next aria-label="Next photo">›</button>
			</div>
		</dialog>
		<script id="gallery-data" type="application/json" set:html={JSON.stringify(normalizedPhotos)} />
		<Footer />
		<script>
			const photos = JSON.parse(document.getElementById('gallery-data')?.textContent || '[]');
			const galleryDialog = document.getElementById('gallery-dialog');
			const galleryImage = document.querySelector('[data-gallery-image]');
			const galleryCaption = document.querySelector('[data-gallery-caption]');
			let activePhoto = 0;
			let touchStartX = 0;

			const showPhoto = () => {
				const photo = photos[activePhoto];
				if (!photo || !(galleryImage instanceof HTMLImageElement) || !galleryCaption) return;
				galleryImage.src = photo.src;
				galleryImage.alt = photo.caption || '';
				galleryCaption.textContent = photo.caption || '';
			};

			const movePhoto = (direction) => {
				if (!photos.length) return;
				activePhoto = (activePhoto + direction + photos.length) % photos.length;
				showPhoto();
			};

			document.querySelectorAll('[data-photo]').forEach((button) => {
				button.addEventListener('click', () => {
					activePhoto = Number(button.getAttribute('data-photo') || 0);
					showPhoto();
					if (galleryDialog instanceof HTMLDialogElement) galleryDialog.showModal();
				});
			});
			document.querySelector('[data-gallery-close]')?.addEventListener('click', () => {
				if (galleryDialog instanceof HTMLDialogElement) galleryDialog.close();
			});
			document.querySelector('[data-gallery-prev]')?.addEventListener('click', () => movePhoto(-1));
			document.querySelector('[data-gallery-next]')?.addEventListener('click', () => movePhoto(1));
			galleryDialog?.addEventListener('touchstart', (event) => {
				touchStartX = event.changedTouches[0]?.clientX || 0;
			});
			galleryDialog?.addEventListener('touchend', (event) => {
				const touchEndX = event.changedTouches[0]?.clientX || 0;
				const delta = touchEndX - touchStartX;
				if (Math.abs(delta) > 50) movePhoto(delta > 0 ? -1 : 1);
			});
		</script>
	</body>
</html>
