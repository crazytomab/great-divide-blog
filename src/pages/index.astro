---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection, render } from 'astro:content';
import HeroBackground from '../assets/BandTheader.jpg';
import { CHARITY_URL, GARMIN_MAP_EMBED_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => {
	const dateDiff = (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0);
	return dateDiff || (b.data.day ?? 0) - (a.data.day ?? 0);
});

const updates = await Promise.all(
	posts.map(async (post) => {
		const { Content } = await render(post);
		return { post, Content };
	}),
);

const latestPost = posts[0];
const totalDistanceKm = posts.reduce((total, post) => total + (post.data.distanceKm ?? 0), 0);
const totalElevationM = posts.reduce((total, post) => total + (post.data.elevationM ?? 0), 0);
const latestLocation =
	latestPost?.data.routeEnd || latestPost?.data.routeStart || (posts.length > 0 ? 'Location pending' : 'Not started');

const getPostTitle = (post: (typeof posts)[number]) => {
	const route =
		post.data.routeStart || post.data.routeEnd
			? `${post.data.routeStart ?? ''}${post.data.routeStart && post.data.routeEnd ? ' → ' : ''}${post.data.routeEnd ?? ''}`
			: 'Route pending';

	return `${post.data.day ? `Day ${post.data.day}` : 'Update'}: ${route}`;
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			:global(body) {
				background: #c4b68f;
				background-image: none;
			}
			main {
				width: 100%;
				max-width: none;
				padding: 0;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.75rem 1rem;
				border: 0;
				border-radius: 999px;
				background: var(--accent);
				color: white;
				font: inherit;
				font-weight: 700;
				text-decoration: none;
				cursor: pointer;
			}
			.button.secondary {
				background: rgba(255, 255, 255, 0.86);
				color: rgb(var(--gray-dark));
			}
			.button.charity {
				background: #f6d36f;
				color: rgb(var(--gray-dark));
			}
			.button.disabled {
				cursor: not-allowed;
				opacity: 0.78;
			}
			.top-section {
				position: relative;
				isolation: isolate;
				min-height: 100vh;
				padding: 1rem 1rem 4rem;
				background-image:
					linear-gradient(180deg, rgba(15, 18, 25, 0.42), rgba(15, 18, 25, 0.18) 45%, rgba(15, 18, 25, 0) 100%),
					var(--hero-image);
				background-position: center top;
				background-repeat: no-repeat;
				background-size: cover;
				background-attachment: fixed;
			}
			.top-inner {
				width: min(1280px, 100%);
				margin: 0 auto;
			}
			.site-hero {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.8rem 0 1rem;
				color: white;
			}
			.site-title {
				max-width: 760px;
			}
			.site-title .kicker {
				color: rgba(255, 255, 255, 0.78);
			}
			.site-title h1 {
				margin-bottom: 0.4rem;
				color: white;
				font-size: clamp(2.6rem, 6vw, 4.5rem);
				text-shadow: 0 3px 20px rgba(var(--black), 35%);
			}
			.site-title p {
				max-width: 640px;
				margin: 0;
				color: rgba(255, 255, 255, 0.86);
				font-size: 1.1rem;
			}
			.site-actions {
				position: sticky;
				top: 0.8rem;
				z-index: 20;
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.75rem;
				padding-top: 0.35rem;
			}
			.map-anchor {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 320px;
				gap: 1rem;
				min-height: calc(100vh - 2rem);
				margin-top: clamp(18rem, 58vh, 44rem);
				margin-bottom: 0;
			}
			.map-panel,
			.trip-panel,
			.update {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 28px;
				background: rgba(255, 255, 255, 0.9);
				box-shadow: 0 16px 40px rgba(var(--gray), 18%);
			}
			.map-panel {
				position: relative;
				overflow: hidden;
				min-height: 560px;
				background: rgba(255, 255, 255, 0.84);
				backdrop-filter: blur(5px);
			}
			.map-panel iframe {
				width: 100%;
				height: 100%;
				min-height: 560px;
				border: 0;
			}
			.map-fallback {
				position: relative;
				display: grid;
				min-height: 560px;
				padding: 2rem;
				overflow: hidden;
				background:
					radial-gradient(circle at 20% 20%, rgba(35, 55, 255, 0.16), transparent 22rem),
					linear-gradient(135deg, #f6f1df 0%, #c9d8b8 45%, #aebf9c 100%);
			}
			.map-fallback::before {
				content: '';
				position: absolute;
				inset: 8% 16% 10% 20%;
				border-left: 10px solid rgba(34, 41, 57, 0.26);
				border-bottom: 10px solid rgba(34, 41, 57, 0.2);
				border-radius: 52% 44% 58% 36%;
				transform: rotate(-10deg);
			}
			.route-label {
				position: relative;
				align-self: start;
				max-width: 560px;
				padding: 1.25rem;
				border-radius: 22px;
				background: rgba(255, 255, 255, 0.82);
				backdrop-filter: blur(6px);
			}
			.route-label p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.route-label h1 {
				margin-bottom: 0.75rem;
				font-size: clamp(2.4rem, 6vw, 5.2rem);
			}
			.latest-marker {
				position: absolute;
				right: 15%;
				bottom: 20%;
				display: grid;
				gap: 0.35rem;
				max-width: 220px;
				padding: 0.8rem 1rem;
				border-radius: 18px;
				background: rgb(var(--gray-dark));
				color: white;
				box-shadow: 0 12px 30px rgba(var(--black), 28%);
			}
			.latest-marker::before {
				content: '';
				position: absolute;
				left: 50%;
				bottom: -14px;
				width: 22px;
				height: 22px;
				border: 5px solid white;
				border-radius: 999px;
				background: var(--accent);
				transform: translateX(-50%);
			}
			.latest-marker span {
				color: rgba(255, 255, 255, 0.72);
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.latest-marker strong {
				font-size: 1.25rem;
				line-height: 1.1;
			}
			.trip-panel {
				display: flex;
				flex-direction: column;
				gap: 1rem;
				padding: 1.25rem;
				background: rgba(234, 233, 241, 0.82);
				backdrop-filter: blur(7px);
			}
			.kicker {
				margin: 0 0 0.5rem;
				color: var(--accent-dark);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.trip-panel h2 {
				font-size: 1.7rem;
			}
			.stats {
				display: grid;
				gap: 0.75rem;
			}
			.stat {
				padding: 1rem;
				border-radius: 18px;
				background: rgb(var(--gray-dark));
				color: white;
			}
			.stat strong {
				display: block;
				font-size: 1.45rem;
				line-height: 1.15;
			}
			.stat span {
				color: rgba(255, 255, 255, 0.72);
				font-size: 0.85rem;
			}
			.about-copy {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			dialog {
				width: min(720px, calc(100% - 2rem));
				max-height: calc(100vh - 2rem);
				padding: 0;
				border: 0;
				border-radius: 28px;
				box-shadow: 0 24px 70px rgba(var(--black), 35%);
			}
			dialog::backdrop {
				background: rgba(var(--black), 45%);
				backdrop-filter: blur(3px);
			}
			.dialog-inner {
				padding: 1.5rem;
			}
			.dialog-header {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
			}
			.close-button {
				width: 2.4rem;
				height: 2.4rem;
				border: 0;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font: inherit;
				cursor: pointer;
			}
			.about-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}
			.about-card {
				padding: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 18px;
				background: #ffffff;
			}
			.about-card h3 {
				font-size: 1.1rem;
			}
			.about-card p {
				margin: 0;
				font-size: 0.95rem;
			}
			.feed {
				display: grid;
				gap: 1.25rem;
				width: 100%;
				margin: 2rem auto 0;
				padding-bottom: 2rem;
			}
			.feed-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
			}
			.feed-header p {
				margin: 0;
				color: white;
			}
			.update {
				padding: 1.25rem;
			}
			.update-header {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.update-meta {
				margin: 0 0 0.35rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.update h3 {
				margin-bottom: 0.35rem;
				font-size: 1.8rem;
			}
			.update-stats {
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.5rem;
				min-width: 220px;
			}
			.update-stats span {
				padding: 0.35rem 0.6rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
			}
			.update-body {
				max-width: 840px;
			}
			.update-body p:last-child {
				margin-bottom: 0;
			}
			.update-body img {
				display: block;
				width: min(100%, 620px);
				max-height: 460px;
				margin: 1rem auto;
				border-radius: 18px;
				object-fit: cover;
				box-shadow: 0 10px 30px rgba(var(--gray), 22%);
			}
			.update-body a:has(img) {
				display: block;
				width: fit-content;
				max-width: 100%;
				margin: 0 auto;
				color: inherit;
				text-decoration: none;
			}
			.update-body p:has(> em:only-child) {
				width: min(100%, 620px);
				margin: -0.35rem auto 1rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
				line-height: 1.45;
				text-align: center;
			}
			.update-body em {
				color: rgb(var(--gray));
			}
			.photo-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 0.75rem;
				margin-top: 1rem;
			}
			.photo-grid a {
				display: block;
				overflow: hidden;
				border-radius: 16px;
				background: rgb(var(--gray-light));
			}
			.photo-grid img {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				transition: transform 0.2s ease;
			}
			.photo-grid a:hover img {
				transform: scale(1.03);
			}
			@media (max-width: 980px) {
				.map-anchor {
					grid-template-columns: 1fr;
					min-height: auto;
				}
				.map-panel,
				.map-panel iframe,
				.map-fallback {
					min-height: 520px;
				}
				.site-hero {
					display: block;
				}
				.site-actions {
					justify-content: flex-start;
					margin-top: 1rem;
				}
				.trip-panel {
					display: grid;
					grid-template-columns: 1fr;
				}
				.stats,
				.about-grid {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
					padding: 0;
				}
				.top-section {
					padding: 0.5rem;
					background-position: center top;
					background-attachment: scroll;
				}
				.site-title h1 {
					font-size: clamp(1.45rem, 8vw, 2.4rem);
				}
				.site-title p {
					display: none;
				}
				.site-hero {
					margin: 0 -0.5rem;
					padding: 0.55rem 0.5rem 0.7rem;
				}
				.site-actions {
					gap: 0.45rem;
					top: 0.5rem;
					width: fit-content;
					margin-left: auto;
					padding: 0.35rem;
					border-radius: 999px;
					background: rgba(15, 18, 25, 0.42);
					backdrop-filter: blur(8px);
				}
				.button {
					padding: 0.55rem 0.7rem;
					font-size: 0.9rem;
				}
				.map-anchor {
					margin-top: clamp(12rem, 45vh, 28rem);
				}
				.map-panel,
				.map-panel iframe,
				.map-fallback {
					min-height: 430px;
				}
				.map-fallback {
					padding: 1rem;
				}
				.latest-marker {
					right: 1rem;
					bottom: 1.5rem;
				}
				.update-header,
				.feed-header {
					display: block;
				}
				.update-stats {
					justify-content: flex-start;
					margin-top: 0.75rem;
				}
				.update-body img,
				.update-body p:has(> em:only-child) {
					width: 100%;
					max-height: 360px;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<section class="top-section" style={`--hero-image: url(${HeroBackground.src});`}>
				<div class="top-inner">
					<header class="site-hero" aria-labelledby="route-title">
						<div class="site-title">
							<h1 id="route-title">Bikepacking from Canada to Mexico</h1>
							<p>
								Following the route, the latest Garmin location, and short updates from the road.
							</p>
						</div>
						<div class="site-actions" aria-label="Page actions">
							<button class="button secondary" type="button" data-open-about>
								About
							</button>
							{
								CHARITY_URL ? (
									<a class="button charity" href={CHARITY_URL} target="_blank" rel="noreferrer">
										Charity
									</a>
								) : (
									<span class="button charity disabled" aria-disabled="true" title="Charity link coming soon">
										Charity link coming soon
									</span>
								)
							}
						</div>
					</header>

					<section class="map-anchor" aria-label="Route progress">
						<div class="map-panel" id="progress-map" aria-label="Great Divide progress map">
							{
								GARMIN_MAP_EMBED_URL ? (
									<iframe title="Garmin inReach progress map" src={GARMIN_MAP_EMBED_URL} loading="lazy" />
								) : (
									<div class="map-fallback">
										<div class="route-label">
											<p class="kicker">Progress map</p>
											<h2>Route map pending</h2>
											<p>
												The Garmin inReach map will sit here once the MapShare embed URL is added.
												For now, this panel anchors the latest known point from the updates.
											</p>
										</div>
										<div class="latest-marker">
											<span>Latest location</span>
											<strong>{latestLocation}</strong>
										</div>
									</div>
								)
							}
						</div>

						<aside class="trip-panel" aria-label="Trip progress summary">
							<div>
								<p class="kicker">Trip Progress</p>
							</div>

							<div class="stats">
								<div class="stat">
									<strong>{totalDistanceKm.toLocaleString('en-GB')} km</strong>
									<span>Total logged distance</span>
								</div>
								<div class="stat">
									<strong>{totalElevationM.toLocaleString('en-GB')} m</strong>
									<span>Total logged elevation</span>
								</div>
								<div class="stat">
									<strong>{latestLocation}</strong>
									<span>Most recent location</span>
								</div>
								<div class="stat">
									<strong>{latestPost?.data.pubDate ? <FormattedDate date={latestPost.data.pubDate} /> : 'Pending'}</strong>
									<span>Latest update</span>
								</div>
							</div>

							<div>
								<p class="about-copy">
									Beth and Tom are riding the Great Divide Mountain Bike Route and raising money
									for charity.
								</p>
							</div>
						</aside>
					</section>

					<section class="feed" id="latest-updates" aria-labelledby="latest-updates-title">
						<div class="feed-header">
							<div>
								<p class="kicker">Trail journal</p>
								<h2 id="latest-updates-title">Trip Updates</h2>
							</div>
						</div>

						{
							updates.length > 0 ? (
								updates.map(({ post, Content }) => (
									<article class="update">
										<div class="update-header">
											<div>
												<p class="update-meta">
													{post.data.pubDate && <FormattedDate date={post.data.pubDate} />}
												</p>
												<h3>{getPostTitle(post)}</h3>
											</div>
											<div class="update-stats" aria-label="Ride details">
												{post.data.distanceKm && <span>{post.data.distanceKm} km</span>}
												{post.data.elevationM && <span>{post.data.elevationM} m</span>}
											</div>
										</div>
										<div class="update-body">
											<Content />
										</div>
										{post.data.photos.length > 0 && (
											<div class="photo-grid" aria-label={`${getPostTitle(post)} photos`}>
												{post.data.photos.map((photo) => (
													<a href={photo} target="_blank" rel="noreferrer">
														<img src={photo} alt="" loading="lazy" />
													</a>
												))}
											</div>
										)}
									</article>
								))
							) : (
								<p>No updates yet. Check back once we are on the road.</p>
							)
						}
					</section>
				</div>
			</section>

			<dialog id="about-dialog" aria-labelledby="about-title">
				<div class="dialog-inner">
					<div class="dialog-header">
						<div>
							<p class="kicker">About the ride</p>
							<h2 id="about-title">What are we doing?</h2>
						</div>
						<button class="close-button" type="button" data-close-about aria-label="Close about dialog">×</button>
					</div>
					<p>
						Hi. We are Beth and Tom from Sheffield, UK 👋
					</p>
					<p>
						New to bikepacking and newly married, we are attempting to cycle unsupported from Canada to Mexico along
					    the Great Divide Mountain Bike Route (GDMBR). This journey follows the continetal divide of the USA 
						mostly on unpaved tracks, covering roughly 4,000km with 53,000m of elevation gain. Along the way there will
						be bear filled forests, high mountain passes and vast desert plains. 
					</p>
					<p>
					    In taking on this challenge we would like to try and raise some money for two great charities:
					</p>
					<div class="about-grid">
						<article class="about-card">
							<h3>Breast Cancer Now</h3>
							<p>
							    This charity focuses on research to improve the prevention, diagnosis and treatment of breast
								cancer. We have chosen the GDMBR as a way to follow in Beth's parents footsteps/tyretracks -
								They completed this route before Jane's cancer journey. Beth will be riding the route on a bike
								that has been built mostly using components from the bike Jane completed the trip on.
							</p>
						</article>
						<article class="about-card">
							<h3>Dukes Barn</h3>
							<p>
							    Focuses on making outdoor adventures accesible for those with additional needs.
							</p>
						</article>
					</div>
					<p>
					    Any donations to either of these charites would be very gratefully recieved! All funds raised will be
						going directly to charity, the trip itself is self funded.
					</p>
				</div>
			</dialog>

		</main>
		<Footer />
		<script>
			const aboutDialog = document.getElementById('about-dialog');
			const openAbout = document.querySelector('[data-open-about]');
			const closeAbout = document.querySelector('[data-close-about]');

			openAbout?.addEventListener('click', () => {
				if (aboutDialog instanceof HTMLDialogElement) aboutDialog.showModal();
			});

			closeAbout?.addEventListener('click', () => {
				if (aboutDialog instanceof HTMLDialogElement) aboutDialog.close();
			});

			aboutDialog?.addEventListener('click', (event) => {
				if (event.target === aboutDialog && aboutDialog instanceof HTMLDialogElement) {
					aboutDialog.close();
				}
			});
		</script>
	</body>
</html>
