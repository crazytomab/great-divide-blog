---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection, render } from 'astro:content';
import { GARMIN_MAP_EMBED_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort((a, b) => {
	const dateDiff = (b.data.pubDate?.valueOf() ?? 0) - (a.data.pubDate?.valueOf() ?? 0);
	return dateDiff || (b.data.day ?? 0) - (a.data.day ?? 0);
});

const updates = await Promise.all(
	posts.map(async (post) => {
		const { Content } = await render(post);
		return { post, Content };
	}),
);

const latestPost = posts[0];
const totalDistanceKm = posts.reduce((total, post) => total + (post.data.distanceKm ?? 0), 0);
const totalElevationM = posts.reduce((total, post) => total + (post.data.elevationM ?? 0), 0);
const latestLocation =
	latestPost?.data.routeEnd || latestPost?.data.routeStart || (posts.length > 0 ? 'Location pending' : 'Not started');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(1280px, calc(100% - 2rem));
				padding-top: 1.5rem;
			}
			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.75rem 1rem;
				border: 0;
				border-radius: 999px;
				background: var(--accent);
				color: white;
				font: inherit;
				font-weight: 700;
				text-decoration: none;
				cursor: pointer;
			}
			.button.secondary {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.map-anchor {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 320px;
				gap: 1rem;
				min-height: calc(100vh - 170px);
				margin-bottom: 2rem;
			}
			.map-panel,
			.trip-panel,
			.update {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 28px;
				background: rgba(255, 255, 255, 0.9);
				box-shadow: 0 16px 40px rgba(var(--gray), 18%);
			}
			.map-panel {
				position: relative;
				overflow: hidden;
				min-height: 620px;
			}
			.map-panel iframe {
				width: 100%;
				height: 100%;
				min-height: 620px;
				border: 0;
			}
			.map-fallback {
				position: relative;
				display: grid;
				min-height: 620px;
				padding: 2rem;
				overflow: hidden;
				background:
					radial-gradient(circle at 20% 20%, rgba(35, 55, 255, 0.16), transparent 22rem),
					linear-gradient(135deg, #f6f1df 0%, #c9d8b8 45%, #aebf9c 100%);
			}
			.map-fallback::before {
				content: '';
				position: absolute;
				inset: 8% 16% 10% 20%;
				border-left: 10px solid rgba(34, 41, 57, 0.26);
				border-bottom: 10px solid rgba(34, 41, 57, 0.2);
				border-radius: 52% 44% 58% 36%;
				transform: rotate(-10deg);
			}
			.route-label {
				position: relative;
				align-self: start;
				max-width: 560px;
				padding: 1.25rem;
				border-radius: 22px;
				background: rgba(255, 255, 255, 0.82);
				backdrop-filter: blur(6px);
			}
			.route-label p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.route-label h1 {
				margin-bottom: 0.75rem;
				font-size: clamp(2.4rem, 6vw, 5.2rem);
			}
			.latest-marker {
				position: absolute;
				right: 15%;
				bottom: 20%;
				display: grid;
				gap: 0.35rem;
				max-width: 220px;
				padding: 0.8rem 1rem;
				border-radius: 18px;
				background: rgb(var(--gray-dark));
				color: white;
				box-shadow: 0 12px 30px rgba(var(--black), 28%);
			}
			.latest-marker::before {
				content: '';
				position: absolute;
				left: 50%;
				bottom: -14px;
				width: 22px;
				height: 22px;
				border: 5px solid white;
				border-radius: 999px;
				background: var(--accent);
				transform: translateX(-50%);
			}
			.latest-marker span {
				color: rgba(255, 255, 255, 0.72);
				font-size: 0.8rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;
			}
			.latest-marker strong {
				font-size: 1.25rem;
				line-height: 1.1;
			}
			.trip-panel {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.25rem;
			}
			.kicker {
				margin: 0 0 0.5rem;
				color: var(--accent-dark);
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.trip-panel h2 {
				font-size: 1.7rem;
			}
			.stats {
				display: grid;
				gap: 0.75rem;
			}
			.stat {
				padding: 1rem;
				border-radius: 18px;
				background: rgb(var(--gray-dark));
				color: white;
			}
			.stat strong {
				display: block;
				font-size: 1.45rem;
				line-height: 1.15;
			}
			.stat span {
				color: rgba(255, 255, 255, 0.72);
				font-size: 0.85rem;
			}
			.about-copy {
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			dialog {
				width: min(720px, calc(100% - 2rem));
				max-height: calc(100vh - 2rem);
				padding: 0;
				border: 0;
				border-radius: 28px;
				box-shadow: 0 24px 70px rgba(var(--black), 35%);
			}
			dialog::backdrop {
				background: rgba(var(--black), 45%);
				backdrop-filter: blur(3px);
			}
			.dialog-inner {
				padding: 1.5rem;
			}
			.dialog-header {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
			}
			.close-button {
				width: 2.4rem;
				height: 2.4rem;
				border: 0;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font: inherit;
				cursor: pointer;
			}
			.about-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 1rem;
			}
			.about-card {
				padding: 1rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 18px;
				background: #fff;
			}
			.about-card h3 {
				font-size: 1.1rem;
			}
			.about-card p {
				margin: 0;
				font-size: 0.95rem;
			}
			.feed {
				display: grid;
				gap: 1.25rem;
				margin-top: 2rem;
			}
			.feed-header {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
			}
			.feed-header p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.update {
				padding: 1.25rem;
			}
			.update-header {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
				margin-bottom: 1rem;
			}
			.update-meta {
				margin: 0 0 0.35rem;
				color: rgb(var(--gray));
				font-size: 0.9rem;
			}
			.update h3 {
				margin-bottom: 0.35rem;
				font-size: 1.8rem;
			}
			.update-stats {
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.5rem;
				min-width: 220px;
			}
			.update-stats span {
				padding: 0.35rem 0.6rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				font-size: 0.85rem;
			}
			.update-body {
				max-width: 840px;
			}
			.update-body p:last-child {
				margin-bottom: 0;
			}
			.photo-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
				gap: 0.75rem;
				margin-top: 1rem;
			}
			.photo-grid a {
				display: block;
				overflow: hidden;
				border-radius: 16px;
				background: rgb(var(--gray-light));
			}
			.photo-grid img {
				display: block;
				width: 100%;
				aspect-ratio: 4 / 3;
				object-fit: cover;
				transition: transform 0.2s ease;
			}
			.photo-grid a:hover img {
				transform: scale(1.03);
			}
			@media (max-width: 980px) {
				.map-anchor {
					grid-template-columns: 1fr;
					min-height: auto;
				}
				.map-panel,
				.map-panel iframe,
				.map-fallback {
					min-height: 520px;
				}
				.trip-panel {
					display: grid;
					grid-template-columns: 1fr;
				}
				.stats,
				.about-grid {
					grid-template-columns: 1fr;
				}
			}
			@media (max-width: 720px) {
				main {
					width: min(100%, calc(100% - 1rem));
					padding: 0.75rem 0.5rem;
				}
				.map-panel,
				.map-panel iframe,
				.map-fallback {
					min-height: 430px;
				}
				.map-fallback {
					padding: 1rem;
				}
				.latest-marker {
					right: 1rem;
					bottom: 1.5rem;
				}
				.update-header,
				.feed-header {
					display: block;
				}
				.update-stats {
					justify-content: flex-start;
					margin-top: 0.75rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="map-anchor" aria-labelledby="route-title">
				<div class="map-panel" id="progress-map" aria-label="Great Divide progress map">
					{
						GARMIN_MAP_EMBED_URL ? (
							<iframe title="Garmin inReach progress map" src={GARMIN_MAP_EMBED_URL} loading="lazy" />
						) : (
							<div class="map-fallback">
								<div class="route-label">
									<p class="kicker">Canada to Mexico by bike</p>
									<h1 id="route-title">Beth and Tom on the Great Divide</h1>
									<p>
										The Garmin inReach map will sit here once the MapShare embed URL is added.
										For now, this panel anchors the route and latest known point from the updates.
									</p>
								</div>
								<div class="latest-marker">
									<span>Latest location</span>
									<strong>{latestLocation}</strong>
								</div>
							</div>
						)
					}
				</div>

				<aside class="trip-panel" aria-label="Trip progress summary">
					<div>
						<p class="kicker">Progress</p>
						<h2>Route, location, and ride totals at a glance.</h2>
						<p class="about-copy">
							Follow the map first, then scroll straight into the latest notes and photos from the
							road.
						</p>
					</div>

					<div class="stats">
						<div class="stat">
							<strong>{totalDistanceKm.toLocaleString('en-GB')} km</strong>
							<span>Total logged distance</span>
						</div>
						<div class="stat">
							<strong>{totalElevationM.toLocaleString('en-GB')} m</strong>
							<span>Total logged elevation</span>
						</div>
						<div class="stat">
							<strong>{latestLocation}</strong>
							<span>Most recent location</span>
						</div>
						<div class="stat">
							<strong>{latestPost?.data.pubDate ? <FormattedDate date={latestPost.data.pubDate} /> : 'Pending'}</strong>
							<span>Latest update</span>
						</div>
					</div>

					<div>
						<p class="about-copy">
							Beth and Tom are riding the Great Divide Mountain Bike Route and raising money for
							charity.
						</p>
						<button class="button secondary" type="button" data-open-about>About Beth, Tom & charities</button>
					</div>
				</aside>
			</section>

			<dialog id="about-dialog" aria-labelledby="about-title">
				<div class="dialog-inner">
					<div class="dialog-header">
						<div>
							<p class="kicker">About the ride</p>
							<h2 id="about-title">Beth, Tom, and the charities</h2>
						</div>
						<button class="close-button" type="button" data-close-about aria-label="Close about dialog">×</button>
					</div>
					<p>
						We are Beth and Tom from Sheffield, UK, and we are preparing to ride the Great Divide
						Mountain Bike Route from Canada to Mexico.
					</p>
					<p>
						This site collects the route map, short updates from the road, photos from each stage,
						and links to the charities we are supporting. The practical rhythm is simple: ride, send
						a Garmin inReach point when we can, post a short note when we have signal, then keep
						moving south.
					</p>
					<div class="about-grid">
						<article class="about-card">
							<h3>Beth</h3>
							<p>Taking on the Divide for the challenge, the landscapes, and the causes we care about.</p>
						</article>
						<article class="about-card">
							<h3>Tom</h3>
							<p>Documenting the route, keeping the bikes moving, and sharing notes from the road.</p>
						</article>
						<article class="about-card">
							<h3>Charities</h3>
							<p>Donation links and confirmed charity details can be added here when ready.</p>
						</article>
					</div>
				</div>
			</dialog>

			<section class="feed" id="latest-updates" aria-labelledby="latest-updates-title">
				<div class="feed-header">
					<div>
						<p class="kicker">Trail journal</p>
						<h2 id="latest-updates-title">Latest updates</h2>
					</div>
					<p>Newest first. Full update text is shown here; click any photo for the full-size file.</p>
				</div>

				{
					updates.length > 0 ? (
						updates.map(({ post, Content }) => (
							<article class="update">
								<div class="update-header">
									<div>
										<p class="update-meta">
											{post.data.pubDate && <FormattedDate date={post.data.pubDate} />}
											{post.data.day && ` · Day ${post.data.day}`}
										</p>
										<h3>{post.data.title}</h3>
										<p>{post.data.description}</p>
									</div>
									<div class="update-stats" aria-label="Ride details">
										{(post.data.routeStart || post.data.routeEnd) && (
											<span>
												{post.data.routeStart}
												{post.data.routeStart && post.data.routeEnd ? ' → ' : ''}
												{post.data.routeEnd}
											</span>
										)}
										{post.data.distanceKm && <span>{post.data.distanceKm} km</span>}
										{post.data.elevationM && <span>{post.data.elevationM} m up</span>}
									</div>
								</div>
								<div class="update-body">
									<Content />
								</div>
								{post.data.photos.length > 0 && (
									<div class="photo-grid" aria-label={`${post.data.title} photos`}>
										{post.data.photos.map((photo) => (
											<a href={photo} target="_blank" rel="noreferrer">
												<img src={photo} alt="" loading="lazy" />
											</a>
										))}
									</div>
								)}
							</article>
						))
					) : (
						<p>No updates yet. Check back once we are on the road.</p>
					)
				}
			</section>
		</main>
		<Footer />
		<script>
			const aboutDialog = document.getElementById('about-dialog');
			const openAbout = document.querySelector('[data-open-about]');
			const closeAbout = document.querySelector('[data-close-about]');

			openAbout?.addEventListener('click', () => {
				if (aboutDialog instanceof HTMLDialogElement) aboutDialog.showModal();
			});

			closeAbout?.addEventListener('click', () => {
				if (aboutDialog instanceof HTMLDialogElement) aboutDialog.close();
			});

			aboutDialog?.addEventListener('click', (event) => {
				if (event.target === aboutDialog && aboutDialog instanceof HTMLDialogElement) {
					aboutDialog.close();
				}
			});
		</script>
	</body>
</html>
